{
  "name": "bx402",
  "version": "0.9.0",
  "description": "Micropayment proxy for the Brave Search API over x402 and MPP",
  "license": "MPL-2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.12.1"
  },
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:facilitator": "node dist/facilitator/main.js",
    "lint": "biome ci .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "3.1164.0",
    "@aws-sdk/client-kms": "3.1164.0",
    "@aws-sdk/client-s3": "3.1164.0",
    "@hono/node-server": "2.1.6",
    "@prometheus-io/client": "0.16.1",
    "@smithy/node-http-handler": "4.12.1",
    "@x402/core": "2.29.0",
    "@x402/evm": "2.29.0",
    "hono": "4.13.16",
    "mppx": "0.13.6",
    "ox": "0.14.45",
    "undici": "8.12.3",
    "viem": "2.57.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@types/node": "26.6.5",
    "@x402/extensions": "2.29.0",
    "aws-sdk-client-mock": "4.1.0",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
